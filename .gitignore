*.key
*.pem
secrets.yaml
.env
.env.local

# Raspberry Pi specific
*.swp
*.swo
*~

# Kismet data files
*.kismet
*.pcap
*.pcapng

# Database files
*.db
*.sqlite
*.sqlite3

# Backup files
*.backup
*.bak
*.old

# Compiled reports (keep source templates)
outputs/reports/*.html
outputs/reports/*.pdf

# KML files (generated)
outputs/kml/*.kml

# Temporary files
tmp/
temp/
*.tmp

# Jupyter Notebooks (if used for analysis)
.ipynb_checkpoints/
*.ipynb

# Documentation builds
docs/_build/
docs/_static/
docs/_templates/

# OS-specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

